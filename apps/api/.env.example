# Host-only tools / optional host API. Compose supplies db:5432 separately.
NODE_ENV=development
API_PORT=3001
DATABASE_URL=postgresql://simulator:REPLACE_WITH_RANDOM_HEX@127.0.0.1:5432/simulator_fake
WEB_ORIGIN=http://localhost:3000
APP_INSTANCE_ID=REPLACE_WITH_UUID
# Explicit isolated fake mode provides credential-free local backend workflows.
PAYMENT_PROVIDER=fake
SIMULATION_ENABLED=true
SIMULATION_TOKEN=REPLACE_WITH_SIMULATION_TOKEN
TEST_WEBHOOK_SECRET=whsec_fake_REPLACE_WITH_FAKE_WEBHOOK_SECRET
PAYMENT_RETURN_URL=http://localhost:3000/payments/return

# To use Stripe, select PAYMENT_PROVIDER=stripe and SIMULATION_ENABLED=false,
# use a distinct database/environment, and supply all settings below.
# STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_TEST_KEY
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_TEST_KEY
# STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_LISTENER_SECRET
# STRIPE_ACCOUNT_ID=acct_REPLACE_WITH_ACCOUNT
# STRIPE_API_VERSION=2026-11-18.endive
