{
  "name": "@simulator/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env ../../node_modules/@nestjs/cli/bin/nest.js start --watch --no-shell",
    "build": "npm run db:generate && nest build",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "npm run db:generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand --testPathIgnorePatterns=health.integration.spec.ts",
    "test:integration": "node --env-file=.env.test --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand --runTestsByPath test/health.integration.spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-express": "12.5.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "17.2.3",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.13",
    "@nestjs/testing": "12.5.1",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/pg": "8.15.6",
    "@types/supertest": "6.0.3",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "supertest": "7.2.2",
    "ts-jest": "29.4.15",
    "@jest/globals": "30.5.2"
  },
  "type": "module"
}
